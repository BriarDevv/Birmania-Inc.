---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Sectors from "../components/Sectors.astro";
import BrandStatement from "../components/BrandStatement.astro";
import Metrics from "../components/Metrics.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import { buildOrganizationSchema, buildWebPageSchema } from "../lib/seo";

const homeTitle = "Uniformes para Empresas en Argentina | Birmania Inc";
const homeDescription =
  "Diseñamos, producimos y entregamos uniformes para empresas, instituciones y equipos de trabajo en Argentina. Soluciones a medida con color a elección, bordado o estampado DTF.";

const homeStructuredData = [
  buildOrganizationSchema(),
  buildWebPageSchema({
    name: homeTitle,
    description: homeDescription,
    path: "/",
    image: "/images/Banner.webp",
  }),
];
---

<Layout
  title={homeTitle}
  description={homeDescription}
  path="/"
  image="/images/Banner.webp"
  structuredData={homeStructuredData}
>
  <Header intro />
  <main>
    <Hero />
    <Sectors />
    <BrandStatement />
    <div class="divider"></div>
    <Metrics />
    <FinalCTA />
  </main>
  <Footer />
  <WhatsAppFloat />
</Layout>

<style>
  .divider {
    max-width: 1440px;
    margin: 0 auto;
    height: 1px;
    background: #ddd;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { initWhatsAppFloatTheme } from "../scripts/whatsappFloatTheme";

  gsap.registerPlugin(ScrollTrigger);
  initWhatsAppFloatTheme();

  // Hero entrance timeline
  const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

  tl.to("#header", {
    y: 0,
    opacity: 1,
    duration: 0.6,
    onComplete: () => {
      document.getElementById("header")?.classList.remove("header--intro");
    },
  });
  tl.from(".hero__tag", { x: -20, opacity: 0, duration: 0.3 }, "-=0.2");
  tl.from(".hero__headline", { y: 28, opacity: 0, duration: 0.44 }, "-=0.16");
  tl.from(".hero__sub", { y: 14, opacity: 0, duration: 0.3 }, "-=0.24");
  tl.fromTo(
    ".hero__cta",
    { y: 20, opacity: 0 },
    { y: 0, opacity: 1, duration: 0.4, stagger: 0.15 },
    "-=0.2"
  );
  tl.fromTo(
    ".hero__image img",
    { yPercent: 10, opacity: 0 },
    { yPercent: 0, opacity: 1, duration: 0.8, ease: "power2.out" },
    "-=0.35"
  );
  tl.fromTo(
    ".whatsapp-float",
    { scale: 0, opacity: 0 },
    { scale: 1, opacity: 1, duration: 0.5, ease: "back.out(1.7)" },
    "-=0.3"
  );

  // Scroll-triggered animations
  const scrollDefaults = {
    start: "top 85%",
    once: true,
  };

  const shouldAnimateSectorsHeaderOnLoad = () => {
    const sectorsSection = document.querySelector(".sectors");

    if (!sectorsSection || window.innerWidth < 1280) {
      return false;
    }

    const rect = sectorsSection.getBoundingClientRect();
    return rect.top < window.innerHeight - 120;
  };

  const animateSectorsHeaderOnLoad = shouldAnimateSectorsHeaderOnLoad();

  if (animateSectorsHeaderOnLoad) {
    tl.from(".sectors__header", {
      y: 40,
      opacity: 0,
      duration: 0.7,
    }, "+=0.1");
  }

  // Sectors
  if (!animateSectorsHeaderOnLoad) {
    gsap.from(".sectors__header", {
      scrollTrigger: { trigger: ".sectors__header", ...scrollDefaults },
      y: 40,
      opacity: 0,
      duration: 0.7,
    });
  }

  gsap.from(".sectors__card", {
    scrollTrigger: { trigger: ".sectors__grid", ...scrollDefaults },
    y: 40,
    opacity: 0,
    duration: 0.5,
    stagger: 0.1,
  });

  // Brand Statement
  gsap.from(".brand__left", {
    scrollTrigger: { trigger: ".brand__inner", ...scrollDefaults },
    x: -40,
    opacity: 0,
    duration: 0.7,
  });

  gsap.from(".brand__image", {
    scrollTrigger: { trigger: ".brand__inner", ...scrollDefaults },
    x: 40,
    opacity: 0,
    duration: 0.7,
    delay: 0.2,
  });

  // Metrics
  gsap.from(".metrics__left", {
    scrollTrigger: { trigger: ".metrics__inner", ...scrollDefaults },
    y: 30,
    opacity: 0,
    duration: 0.6,
  });

  gsap.from(".metrics__item", {
    scrollTrigger: { trigger: ".metrics__grid", ...scrollDefaults },
    y: 30,
    opacity: 0,
    duration: 0.5,
    stagger: 0.15,
  });

  // Final CTA
  gsap.from(".cta__inner > *", {
    scrollTrigger: { trigger: ".cta__inner", ...scrollDefaults },
    y: 30,
    opacity: 0,
    duration: 0.5,
    stagger: 0.12,
  });

  // Footer
  gsap.from(".footer__top", {
    scrollTrigger: { trigger: ".footer__inner", ...scrollDefaults },
    y: 20,
    opacity: 0,
    duration: 0.6,
  });
</script>
