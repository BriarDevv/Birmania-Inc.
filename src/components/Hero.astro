---

<section class="hero" id="hero">
  <div class="hero__inner">
    <div class="hero__left">
      <div class="hero__tag">
        <span class="hero__tag-text">UNIFORMES PARA EMPRESAS</span>
      </div>
      <h1 class="hero__headline">
        La imagen de tu
        <br class="hero__br" />empresa empieza
        <br class="hero__br" />por su uniforme.
      </h1>
      <p class="hero__sub">
        Diseñamos, producimos y entregamos uniformes para empresas,<br class="hero__sub-br" />
        instituciones y equipos de trabajo en todo el país.<br class="hero__sub-br" />
        Soluciones a medida con calidad, cumplimiento y escala.
      </p>
      <div class="hero__cta-row">
        <a href="/productos" class="hero__cta hero__cta--primary" id="cta_view_products_home">Ver productos</a>
        <a href="#nosotros" class="hero__cta hero__cta--secondary">Conocer más</a>
      </div>
    </div>
    <div class="hero__image">
      <img src="/images/Banner.webp" alt="Equipo de profesionales con uniformes para empresas" />
    </div>
  </div>
</section>

<style>
  .hero {
    background: #fff;
    overflow-x: hidden;
  }

  .hero__inner {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    height: 720px;
    padding: 0 56px;
  }

  .hero__left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 32px;
    width: 680px;
    min-width: 480px;
    padding: 80px 0;
    flex-shrink: 0;
  }

  .hero__tag {
    display: inline-flex;
    align-self: flex-start;
    background: #000;
    padding: 6px 16px;
  }

  .hero__tag-text {
    font-family: "Inter", sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 2px;
    color: #fff;
  }

  .hero__headline {
    font-family: "Sora", sans-serif;
    font-size: 56px;
    font-weight: 800;
    letter-spacing: -2px;
    line-height: 1.05;
    color: #000;
  }

  .hero__sub {
    font-family: "Inter", sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.7;
    color: #777;
  }

  .hero__cta-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: "Inter", sans-serif;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 1px;
    padding: 16px 36px;
    transition:
      background-color 0.22s ease,
      color 0.22s ease,
      border-color 0.22s ease;
    border: 1.5px solid transparent;
  }

  .hero__cta--primary {
    background: #000;
    color: #fff;
    border-color: #000;
  }

  .hero__cta--secondary {
    background: #fff;
    color: #000;
    border: 1.5px solid #000;
  }

  @media (hover: hover) {
    .hero__cta--primary:hover {
      background: #fff;
      color: #000;
      border-color: #000;
    }

    .hero__cta--secondary:hover {
      background: #000;
      color: #fff;
      border-color: #000;
    }
  }

  .hero__image {
    flex: 1;
    height: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform, opacity;
  }

  /* ========= RESPONSIVE ========= */

  @media (max-width: 1200px) {
    .hero__left {
      width: 520px;
      min-width: 380px;
    }

    .hero__headline {
      font-size: 44px;
    }
  }

  @media (max-width: 1024px) {
    .hero__inner {
      flex-direction: column;
      height: auto;
      padding: 0;
    }

    .hero__left {
      width: 100%;
      min-width: unset;
      gap: 24px;
      padding: 48px 32px 56px;
    }

    .hero__headline {
      font-size: 38px;
    }

    .hero__sub {
      font-size: 13px;
    }

    .hero__cta {
      padding: 14px 28px;
      font-size: 12px;
    }

    .hero__image {
      width: 100%;
      height: 400px;
      flex: none;
    }
  }

  @media (max-width: 768px) {
    .hero__inner {
      height: auto;
      padding: 0;
    }

    .hero__left {
      width: 100%;
      min-width: unset;
      padding: 40px 20px 48px;
      gap: 24px;
    }

    .hero__headline {
      font-size: 34px;
      letter-spacing: -1px;
    }

    .hero__headline .hero__br {
      display: none;
    }

    .hero__sub {
      font-size: 14px;
    }

    .hero__sub .hero__sub-br {
      display: none;
    }

    .hero__cta-row {
      flex-direction: column;
      width: 100%;
    }

    .hero__cta {
      width: 100%;
      padding: 16px 24px;
      font-size: 13px;
    }

    .hero__image {
      width: 100%;
      height: 320px;
      flex: none;
    }
  }

  @media (max-width: 480px) {
    .hero__left {
      padding: 32px 16px 40px;
    }

    .hero__headline {
      font-size: 28px;
    }

    .hero__image {
      height: 260px;
    }
  }
</style>
