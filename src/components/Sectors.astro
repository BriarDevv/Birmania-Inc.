---
const sectors = [
  { id: "salud", name: "Salud", image: "/images/sectors/salud.webp" },
  { id: "gastronomia", name: "Gastronomía", image: "/images/sectors/gastronomia.webp" },
  { id: "industria", name: "Industria", image: "/images/sectors/industria.webp" },
  { id: "educacion", name: "Educación", image: "/images/sectors/educacion.webp" },
  { id: "corporativo", name: "Corporativo", image: "/images/sectors/corporativo.webp" },
  { id: "seguridad", name: "Seguridad", image: "/images/sectors/seguridad.webp" },
];
---

<section class="sectors" id="rubros">
  <div class="sectors__inner">
    <div class="sectors__header">
      <span class="sectors__tag">SECTORES</span>
      <h2 class="sectors__title">
        Uniformes para cada <br class="desktop-br" />industria y necesidad.
      </h2>
      <p class="sectors__sub">
        Trabajamos con empresas de distintos rubros. Cada sector tiene<br />
        sus propias exigencias y nosotros las entendemos.
      </p>
    </div>
    <div class="sectors__grid">
      {sectors.map((sector) => (
        <a href={`/productos?sector=${sector.id}`} class="sectors__card" aria-label={`Ver productos de ${sector.name}`}>
          <img src={sector.image} alt={sector.name} loading="lazy" />
          <div class="sectors__card-overlay">
            <span class="sectors__card-label">{sector.name}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .sectors {
    background: #000;
  }

  .sectors__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 80px 56px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .sectors__header {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .sectors__tag {
    font-family: "Inter", sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2px;
    color: #777;
  }

  .sectors__title {
    font-family: "Sora", sans-serif;
    font-size: 42px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.1;
    color: #fff;
  }

  .sectors__sub {
    font-family: "Inter", sans-serif;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.7;
    color: #888;
  }

  .sectors__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
  }

  .sectors__card {
    position: relative;
    height: 280px;
    border-radius: 0;
    overflow: hidden;
    display: block;
  }

  .sectors__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }

  .sectors__card:hover img {
    transform: scale(1.05);
  }

  .sectors__card-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: #000000dd;
    padding: 8px 12px;
  }

  .sectors__card-label {
    font-family: "Sora", sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: #fff;
  }

  /* ========= RESPONSIVE ========= */

  @media (max-width: 1024px) {
    .sectors__inner {
      padding: 64px 32px;
      gap: 36px;
    }

    .sectors__title {
      font-size: 34px;
    }

    .sectors__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .sectors__card {
      height: 240px;
    }
  }

  @media (max-width: 768px) {
    .sectors__inner {
      padding: 56px 20px;
      gap: 32px;
    }

    .sectors__title {
      font-size: 28px;
    }

    .sectors__title .desktop-br {
      display: none;
    }

    .sectors__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .sectors__card {
      height: 200px;
    }
  }

  @media (max-width: 480px) {
    .sectors__inner {
      padding: 48px 16px;
    }

    .sectors__title {
      font-size: 24px;
    }

    .sectors__card {
      height: 180px;
    }
  }
</style>
