<footer class="footer">
  <div class="footer__inner">
    <div class="footer__top">
      <div class="footer__brand">
        <img src="/images/Birmania-Logo-blanco.webp" alt="Birmania Inc" width="181" height="65" />
      </div>
      <div class="footer__links">
        <div class="footer__col">
          <span class="footer__col-title">EMPRESA</span>
          <a href="#nosotros" class="footer__link">Nosotros</a>
          <a href="#" class="footer__link">Proceso</a>
          <a href="#" class="footer__link">Trayectoria</a>
        </div>
        <div class="footer__col">
          <span class="footer__col-title">REDES</span>
          <a href="#" class="footer__link" target="_blank" rel="noopener noreferrer">Instagram</a>
          <a href="#" class="footer__link" target="_blank" rel="noopener noreferrer">WhatsApp</a>
        </div>
        <div class="footer__col">
          <span class="footer__col-title">CONTACTO</span>
          <a href="mailto:info@rpiscitelli.com.ar" class="footer__link">info@rpiscitelli.com.ar</a>
          <a href="tel:+5491151084736" class="footer__link">+54 9 11 5108-4736</a>
          <span class="footer__link footer__link--static">Av. Rivadavia 4005, CABA</span>
        </div>
      </div>
    </div>
    <div class="footer__divider"></div>
    <div class="footer__bottom">
      <span class="footer__copy">© 2026 Birmania Inc. Hecho por <a href="https://briardev.xyz" target="_blank" rel="noopener noreferrer" class="footer__briar">Briar Dev</a>.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #000;
  }

  .footer__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 56px 56px 16px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer__top {
    display: flex;
    justify-content: space-between;
    padding-bottom: 24px;
  }

  .footer__brand img {
    width: 181px;
    height: 65px;
    object-fit: contain;
  }

  .footer__links {
    display: flex;
    gap: 80px;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer__col-title {
    font-family: "Inter", sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 2px;
    color: #777;
  }

  .footer__link {
    font-family: "Inter", sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: #fff;
    transition: opacity 0.2s;
  }

  .footer__link:hover {
    opacity: 0.7;
  }

  .footer__link--static {
    cursor: default;
  }

  .footer__link--static:hover {
    opacity: 1;
  }

  .footer__divider {
    width: 100%;
    height: 1px;
    background: #333;
  }

  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 0;
  }

  .footer__copy {
    font-family: "Inter", sans-serif;
    font-size: 11px;
    font-weight: 400;
    color: #777;
  }

  .footer__briar {
    color: #aaa;
    font-weight: 500;
    text-decoration: none;
    position: relative;
  }

  .footer__briar::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: #aaa;
    transition: width 0.3s ease;
  }

  .footer__briar:hover::after {
    width: 100%;
  }

  /* ========= RESPONSIVE ========= */

  @media (max-width: 1024px) {
    .footer__inner {
      padding: 48px 32px 16px;
    }

    .footer__links {
      gap: 48px;
    }
  }

  @media (max-width: 768px) {
    .footer__inner {
      padding: 40px 20px 16px;
    }

    .footer__top {
      flex-direction: column;
      gap: 40px;
    }

    .footer__brand img {
      width: 140px;
      height: 50px;
    }

    .footer__links {
      flex-wrap: wrap;
      gap: 32px;
    }

    .footer__col {
      min-width: 140px;
    }
  }

  @media (max-width: 480px) {
    .footer__inner {
      padding: 32px 16px 12px;
    }

    .footer__links {
      flex-direction: column;
      gap: 32px;
    }
  }
</style>
