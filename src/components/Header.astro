      </svg>
    </a>

    <button class="header__hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false">
      <span class="header__hamburger-line"></span>
      <span class="header__hamburger-line"></span>
      <span class="header__hamburger-line"></span>
    </button>
    <div class="header__divider"></div>
  </div>
</header>

<!-- Mobile overlay -->
<div class="mobile-overlay" id="mobile-overlay"></div>

<!-- Mobile nav -->
<nav class="mobile-nav" id="mobile-nav">
  <div class="mobile-nav__header">
    <a href="/" class="mobile-nav__logo">
      <img src="/images/Birmania-Logo-blanco.png" alt="Birmania Inc" width="120" height="43" />
    </a>
  </div>

  <div class="mobile-nav__content">
    <div class="mobile-nav__links">
      {navLinks.map((link, i) => (
        <a href={link.href} class="mobile-nav__link" style={`--i: ${i}`}>
          <span class="mobile-nav__link-number">0{i + 1}</span>
          <span class="mobile-nav__link-text">{link.label}</span>
        </a>
      ))}
    </div>
  </div>

  <div class="mobile-nav__footer">
    <a
      href={`https://wa.me/${whatsappNumber}`}
      target="_blank"
      rel="noopener noreferrer"
      class="mobile-nav__cta"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 360 362" width="20" height="20" aria-hidden="true">
