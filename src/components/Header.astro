---
const navLinks = [
  { label: "Productos", href: "#productos" },
  { label: "Nosotros", href: "#nosotros" },
  { label: "Rubros", href: "#rubros" },
  { label: "Contacto", href: "#contacto" },
];

const whatsappNumber = "5491100000000";
---

<header class="header" id="header">
  <div class="header__inner">
    <a href="/" class="header__logo">
      <img src="/images/Birmania-Logo.png" alt="Birmania Inc" width="181" height="65" />
    </a>

    <nav class="header__nav" id="nav">
      {navLinks.map((link) => (
        <a href={link.href} class="header__nav-link">{link.label}</a>
      ))}
    </nav>

    <a
      href={`https://wa.me/${whatsappNumber}`}
      target="_blank"
      rel="noopener noreferrer"
      class="header__cta"
      id="header-whatsapp"
    >
      <svg class="header__cta-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1485.66 345.24" height="23" aria-hidden="true">
