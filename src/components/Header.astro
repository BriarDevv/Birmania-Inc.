      <span>info@rpiscitelli.com.ar</span>
      <span>+54 9 11 5108-4736</span>
    </div>
  </div>
</nav>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 250;
    background: #fff;
  }

  .header__inner {
    --header-side-padding: 56px;
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 95px;
    padding: 24px var(--header-side-padding);
    position: relative;
  }

  .header__logo img {
    width: 181px;
    height: 65px;
    object-fit: contain;
  }

  .header__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
    flex: 1;
  }

  .header__nav-link {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 1px;
    color: #000;
    transition: opacity 0.2s;
  }

  .header__nav-link:hover {
    opacity: 0.6;
  }

  .header__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #000;
    padding: 12px 28px;
    transition: background 0.3s ease;
  }

  .header__cta:hover {
    background: #25D366;
  }

  .header__cta-icon {
    height: 23px;
    width: auto;
  }

  .header__cta-icon path {
    transition: fill 0.3s ease;
  }

  .header__cta:hover .header__cta-icon path {
    fill: #fff;
  }

  .header__divider {
    position: absolute;
    bottom: 0;
    left: var(--header-side-padding);
    right: var(--header-side-padding);
    height: 1px;
    background: #ddd;
  }

  /* Hamburger - compact, animated to X */
  .header__hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 28px;
    height: 28px;
    padding: 0;
    position: relative;
    z-index: 250;
  }

  .header__hamburger-line {
    display: block;
    width: 22px;
    height: 2px;
    background: #000;
    border-radius: 2px;
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.25s ease,
                background 0.3s ease;
    transform-origin: center;
  }

  .header__hamburger.is-active .header__hamburger-line {
    background: #fff;
  }

  .header.menu-open {
    background: transparent;
  }

  .header.menu-open .header__divider {
    opacity: 0;
  }

  .header.menu-open .header__logo {
    opacity: 0;
    pointer-events: none;
  }

  .header__hamburger.is-active .header__hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .header__hamburger.is-active .header__hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .header__hamburger.is-active .header__hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile overlay */
  .mobile-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0);
    z-index: 199;
    pointer-events: none;
    transition: background 0.4s ease;
  }

  .mobile-overlay.active {
    background: rgba(0, 0, 0, 0.6);
    pointer-events: auto;
  }

  /* Mobile nav - dark, full-height panel */
  .mobile-nav {
    display: none;
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 420px;
    height: 100%;
    background: #0a0a0a;
    z-index: 200;
    flex-direction: column;
    padding: 0 20px 20px;
    transform: translateX(100%);
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mobile-nav.active {
    transform: translateX(0);
  }

  .mobile-nav__header {
    display: flex;
    align-items: center;
    height: 64px;
    padding: 14px 0;
    margin-bottom: 24px;
    border-bottom: 1px solid #222;
  }

  .mobile-nav__logo img {
    width: 120px;
    height: 43px;
    object-fit: contain;
  }

  /* Nav content */
  .mobile-nav__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 24px 0;
  }

  .mobile-nav__links {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .mobile-nav__link {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid #1a1a1a;
    transform: translateX(30px);
    opacity: 0;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.4s ease,
                color 0.2s;
    transition-delay: calc(var(--i) * 0.07s + 0.15s);
  }

  .mobile-nav.active .mobile-nav__link {
    transform: translateX(0);
    opacity: 1;
  }

  .mobile-nav__link:first-child {
    border-top: 1px solid #1a1a1a;
  }

  .mobile-nav__link:hover .mobile-nav__link-text {
    color: #fff;
